# Uploaded files must never run as code, even if a bad file slips through.
<FilesMatch "\.(php|phtml|php3|php4|php5|phar|pl|py|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
